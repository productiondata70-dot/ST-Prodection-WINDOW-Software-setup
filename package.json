    "build:win": "vite build && electron-builder --win",
    "build:exe": "vite build && electron-builder --win nsis portable",
    "package:win": "vite build && electron-builder --win nsis portable",
    "package:win:nsis": "vite build && electron-builder --win nsis",
    "package:win:portable": "vite build && electron-builder --win portable",
    "dist": "vite build && electron-builder --win nsis portable",
    "pack": "electron-builder --dir",
    "electron:dev": "vite build && electron .",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
